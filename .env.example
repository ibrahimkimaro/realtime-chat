# Environment variables for Phoenix Realtime Chat Engine
PORT=4000
MIX_ENV=dev

# PostgreSQL database connection URL
DATABASE_URL=postgres://chat_user:chat_password@localhost:5432/realtime_chat_db

# Shared Secret Key used to verify HMAC-SHA256 chat connection tokens and internal events
# IMPORTANT: This must match the SECRET_KEY in your main backend application!
SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# URL of your main backend (FastAPI / Express / etc.) to receive offline push notifications
BACKEND_URL=http://localhost:8000

# WebRTC STUN / TURN Configuration (Optional, for voice/video calling across strict firewalls)
# TURN_SECRET=your-coturn-static-auth-secret
# TURN_HOST=turn.example.com
# TURN_PORT=3478
# TURNS_PORT=5349
# STUN_URLS=stun:stun.l.google.com:19302
